NODE_ENV=development
PORT=8080

YAHOO_EMAIL=you@yahoo.com
YAHOO_APP_PASSWORD=replace-with-yahoo-app-password
MCP_ACCESS_SECRET=replace-with-at-least-24-random-characters

IMAP_HOST=imap.mail.yahoo.com
IMAP_PORT=993
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=587
MAX_MESSAGE_BYTES=20971520
# Caps characters per body part in a tool result. MAX_MESSAGE_BYTES limits the
# fetch; this limits what is returned. Truncated results set truncated: true.
MAX_BODY_CHARS=100000

# Hostnames only, comma-separated. Local defaults are localhost,127.0.0.1.
# On Cloud Run set this to the hostname portion of your service URL.
ALLOWED_HOSTS=localhost,127.0.0.1
# Usually blank for server-to-server MCP clients. If a browser-origin client is used,
# add its hostname(s) here.
ALLOWED_ORIGINS=

# Leave unverified until disposable-account Sent testing passes.
SENT_COPY_MODE=unverified
